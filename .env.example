ACCOUNT_ENCRYPTION_KEY=replace-with-base64-32-byte-key
PERMISSIONS_DEFAULT=readonly
LOG_LEVEL=info
LOG_MESSAGE_CONTENT=false
MAX_MESSAGE_BYTES=262144
